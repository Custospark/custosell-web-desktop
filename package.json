{
  "name": "CUSTOSELL",
  "private": true,
  "version": "4.0.0",
  "description": "Custosell — Your Business Operating System",
  "author": "Custospark Company Ltd",
  "type": "module",
  "main": "dist/desktop/main/main.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:react dev:electron",
    "dev:react": "node ./node_modules/vite/bin/vite.js",
    "clean": "rimraf dist",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "react:build": "tsc -b && vite build",
    "react:build:web": "tsc -b && cross-env VITE_ASSET_BASE=/ vite build",
    "react:build:staging": "tsc -b && cross-env VITE_ASSET_BASE=/ vite build --mode staging",
    "build:staging:web": "npm run react:build:staging",
    "build:react": "npm run react:build",
    "lint": "eslint .",
    "vera:fast": "node scripts/vera-fast.mjs",
    "vera:logic": "node scripts/vera-logic.mjs",
    "vera:extended": "node scripts/vera-extended.mjs",
    "preview": "vite preview",
    "transpile:electron": "node ./node_modules/typescript/bin/tsc --project src/tsconfig.json",
    "build:win": "npm run transpile:electron && npm run react:build && npx electron-builder --win --x64",
    "build:mac": "npm run transpile:electron && npm run react:build && npx electron-builder --mac --arm64",
    "build:linux": "npm run transpile:electron && npm run react:build && npx electron-builder --linux --x64",
    "build:all": "npm run build:win && npm run build:mac && npm run build:linux",
    "publish:win": "npm run transpile:electron && npm run react:build && npx electron-builder --win --x64 --publish always && node scripts/publish-draft.mjs",
    "publish:mac": "npm run transpile:electron && npm run react:build && npx electron-builder --mac --arm64 --publish always && node scripts/publish-draft.mjs",
    "publish:linux": "npm run transpile:electron && npm run react:build && npx electron-builder --linux --x64 --publish always && node scripts/publish-draft.mjs",
    "publish:all": "npm run transpile:electron && npm run react:build && npx electron-builder --win --mac --linux --publish always && node scripts/publish-draft.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/query-sync-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.40.0",
    "html2pdf.js": "^0.14.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.17.0",
    "npm-run-all": "^4.1.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.16.0",
    "react-to-print": "^3.3.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "electron": "^42.3.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.custosell",
    "productName": "Custosell",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "dist/releases/",
      "buildResources": "assets"
    },
    "icon": "assets/icon.png",
    "files": [
      "dist/desktop/**/*",
      "dist/web/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "dist/desktop/preload/preload.js",
        "to": "preload.js"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nodeGypRebuild": false,
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "allowToChangeInstallationDirectory": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "extraMetadata": {
      "main": "dist/desktop/main/main.js"
    },
    "publish": {
      "provider": "github",
      "owner": "Custospark",
      "repo": "custosell-web-desktop"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
